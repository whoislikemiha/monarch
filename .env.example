# Provider credentials for the AI coding agents.
# Copy this file to `.env` and fill in the values you need.
# Only the providers you actually use are required.

# Anthropic (Claude models) — https://console.anthropic.com/
ANTHROPIC_API_KEY=

# OpenAI (GPT / o-series / Codex models) — https://platform.openai.com/
OPENAI_API_KEY=

# OpenRouter (unified gateway to many models) — https://openrouter.ai/
OPENROUTER_API_KEY=

# LM Studio (local models) — base URL of the local server.
# Default when running LM Studio locally:
LMSTUDIO_BASE_URL=http://localhost:1234/v1
