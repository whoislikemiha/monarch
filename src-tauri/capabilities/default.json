{
  "identifier": "default",
  "description": "Default capabilities for monarch",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "shell:allow-open",
    "core:event:default",
    "core:event:allow-emit",
    "core:event:allow-listen",
    "dialog:default",
    "core:webview:allow-set-webview-zoom",
    "clipboard-manager:allow-read-image"
  ]
}
